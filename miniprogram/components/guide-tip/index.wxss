/* Hallmark · component: guide-tip · genre: playful · theme: Hum */
@import "../../styles/tokens.wxss";

.gt-layer {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 3000; /* 盖过自定义 tabBar（999）、全屏拼豆面板（2000）与弹层（--z-modal） */
}
.gt-mask {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background: rgba(18, 23, 27, 0.45);
  opacity: 1;
  transition: opacity 160ms var(--ease-out);
}
.gt-layer--leave .gt-mask {
  opacity: 0;
}
.gt-ring {
  position: absolute;
  z-index: 2;
  border: 4rpx solid var(--color-accent);
  border-radius: var(--radius-input);
  box-shadow: 0 0 0 10rpx rgba(246, 206, 0, 0.22), 0 8rpx 24rpx rgba(18, 23, 27, 0.25);
  pointer-events: none;
}
.gt-ring--pulse {
  animation: gt-pulse 1.4s ease-in-out infinite;
}
@keyframes gt-pulse {
  0%, 100% { box-shadow: 0 0 0 10rpx rgba(246, 206, 0, 0.22), 0 8rpx 24rpx rgba(18, 23, 27, 0.25); }
  50% { box-shadow: 0 0 0 18rpx rgba(246, 206, 0, 0.34), 0 8rpx 24rpx rgba(18, 23, 27, 0.25); }
}
.gt-tapzone {
  position: absolute;
  z-index: 3;
}
.gt-bubble {
  position: absolute;
  z-index: 4;
  box-sizing: border-box;
  padding: 24rpx 28rpx;
  background: var(--color-card);
  border: 2rpx solid var(--color-rule);
  border-radius: var(--radius-input);
  box-shadow: 0 16rpx 48rpx -12rpx var(--color-shadow);
  opacity: 0;
  transform: scale(0.94);
  transition: transform 180ms var(--ease-out), opacity 180ms var(--ease-out), left 180ms var(--ease-out), top 180ms var(--ease-out);
}
.gt-bubble--in {
  opacity: 1;
  transform: scale(1);
}
.gt-arrow {
  position: absolute;
  width: 18px;
  height: 18px;
  background: var(--color-card);
}
.gt-arrow--bottom {
  top: -9px;
  border-top: 2rpx solid var(--color-rule);
  border-left: 2rpx solid var(--color-rule);
  transform: rotate(45deg);
}
.gt-arrow--top {
  bottom: -9px;
  border-bottom: 2rpx solid var(--color-rule);
  border-right: 2rpx solid var(--color-rule);
  transform: rotate(45deg);
}
.gt-text {
  font-size: var(--text-sm);
  color: var(--color-ink);
  line-height: 1.5;
}
.gt-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 16rpx;
}
.gt-progress {
  font-size: var(--text-xs);
  color: var(--color-ink-2);
  font-family: var(--font-label);
}
.gt-btn {
  padding: 12rpx 32rpx;
  border-radius: var(--radius-pill);
  background: var(--color-accent);
  color: var(--color-accent-ink);
  font-size: var(--text-xs);
  font-weight: 600;
  line-height: 1;
  transition: transform var(--dur-micro) var(--ease-out);
}
.gt-btn--pressed {
  transform: scale(0.94);
}
.gt-skip {
  position: fixed;
  right: 32rpx;
  bottom: calc(32rpx + env(safe-area-inset-bottom));
  z-index: 5;
  font-size: var(--text-xs);
  color: rgba(255, 255, 255, 0.72);
  padding: 16rpx 24rpx;
}