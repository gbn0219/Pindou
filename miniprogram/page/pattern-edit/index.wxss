/* Hallmark · macrostructure: Workbench · theme: Hum · genre: playful */
@import "../../styles/tokens.wxss";
@import "../../styles/beading.wxss";

.page {
  padding: var(--space-sm) var(--space-md) calc(var(--space-sm) + env(safe-area-inset-bottom));
}
.card {
  background: var(--color-card);
  border: 5rpx solid #12171b;
  border-radius: var(--radius-card);
  box-shadow: 8rpx 8rpx 0 var(--color-cast);
  margin-bottom: var(--space-md);
  padding: var(--space-md);
}

.top-bar {
  display: flex;
  align-items: center;
  gap: var(--space-sm);
  padding: var(--space-2xs) 0 var(--space-sm);
}
.cell-info {
  flex: 1;
  text-align: right;
  font-family: var(--font-label);
  font-size: var(--text-xs);
  color: var(--color-ink-2);
}

.canvas-shell {
  display: flex;
  flex-direction: column;
  padding: 12rpx;
}
.canvas-area {
  width: 100%;
  aspect-ratio: 1 / 1;
  min-height: 480rpx;
  border-radius: var(--radius-input);
  background: var(--color-paper-2);
  overflow: hidden;
}

.pattern-canvas {
  display: block;
}
.status-bar {
  display: flex;
  align-items: center;
  gap: var(--space-2xs);
  margin: 0 0 var(--space-xs);
  padding: var(--space-2xs) var(--space-sm);
  border-radius: var(--radius-input);
  background: var(--color-paper-2);
  font-size: var(--text-xs);
  color: var(--color-ink-2);
}
.status-text {
  flex: 1;
  line-height: 1.5;
}
.pick-swatch {
  width: 28rpx;
  height: 28rpx;
  border-radius: 50%;
  border: 2rpx solid var(--color-rule);
  box-shadow: inset 0 -3rpx 4rpx var(--color-shadow-inset);
  flex: none;
}

.palette {
  height: 44vh;
  margin: var(--space-sm) calc(-1 * var(--space-md)) 0;
  padding: var(--space-sm) var(--space-md) calc(var(--space-sm) + env(safe-area-inset-bottom));
  background: var(--color-card);
  border-top: 5rpx solid #12171b;
  border-radius: 24rpx 24rpx 0 0;
}
.palette-scroll {
  height: 100%;
}
.palette-group {
  margin-bottom: var(--space-md);
}
.palette-family {
  font-family: var(--font-label);
  font-size: var(--text-xs);
  letter-spacing: 0.08em;
  color: var(--color-ink-2);
  margin-bottom: var(--space-xs);
}
.palette-boxes {
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-2xs);
}
.palette-box {
  width: 104rpx;
  padding: var(--space-2xs) 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
  border-radius: var(--radius-input);
  background: var(--color-paper-2);
  border: 3rpx solid transparent;
  transition: transform var(--dur-micro) var(--ease-out), border-color var(--dur-short) var(--ease-out), background-color var(--dur-short) var(--ease-out);
}
.palette-box--on {
  border-color: #12171b;
  background: #ffffff;
  box-shadow: 2rpx 2rpx 0 var(--color-cast);
}
.palette-box--pressed {
  transform: translateY(2rpx) scale(0.93);
}
.palette-swatch {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  border: 2rpx solid var(--color-rule);
  box-shadow: inset 0 -6rpx 8rpx var(--color-shadow-inset);
}
.palette-code {
  font-family: var(--font-label);
  font-size: 20rpx;
  color: var(--color-ink);
}
.tool-row {
  display: flex;
  gap: var(--space-2xs);
  margin-top: var(--space-sm);
}
.mode-chip {
  flex: 1;
  text-align: center;
  padding: 12rpx 0;
  border-radius: var(--radius-pill);
  background: #ffffff;
  border: 3rpx solid #12171b;
  font-size: var(--text-xs);
  color: var(--color-ink-2);
  transition: background-color var(--dur-short) var(--ease-out), color var(--dur-short) var(--ease-out), border-color var(--dur-short) var(--ease-out), transform var(--dur-micro) var(--ease-out);
}
.btn--soft[disabled] {
  opacity: 0.4;
}
.mode-chip--on {
  /* 浅色磨砂玻璃：选中项不再纯黑 */
  background-image: linear-gradient(115deg, rgba(255, 255, 255, 0.85) 0%, rgba(219, 209, 255, 0.78) 24%, rgba(181, 226, 255, 0.72) 50%, rgba(228, 206, 255, 0.78) 76%, rgba(255, 255, 255, 0.85) 100%);
  background-size: 300% 300%;
  animation: glass-flow 8s ease-in-out infinite;
  border-color: var(--color-ink);
  color: #12171b;
  font-weight: 600;
}
.mode-chip--pressed {
  transform: translateY(2rpx) scale(0.94);
}
.palette-box--src {
  border-color: #12171b;
  box-shadow: 0 0 0 4rpx var(--color-accent);
}

.canvas-hint {
  margin-top: var(--space-2xs);
  text-align: center;
  font-size: var(--text-xs);
  color: var(--color-ink-2);
}
