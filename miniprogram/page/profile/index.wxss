/* miniprogram/page/profile/index.wxss */
@import '../../styles/tokens.wxss';

.page {
  padding: var(--space-md);
  padding-bottom: calc(100rpx + env(safe-area-inset-bottom) + var(--space-xl));
}

.card {
  background: var(--color-card);
  border: 2rpx solid var(--color-rule);
  border-radius: var(--radius-card);
  padding: var(--space-lg);
  box-shadow: 0 12rpx 24rpx -12rpx var(--color-shadow);
  margin-bottom: var(--space-md);
}

.login-card {
  margin-top: var(--space-xl);
  text-align: center;
}
.login-title {
  font-size: var(--text-lg);
  font-weight: 700;
  margin-bottom: var(--space-xs);
}
.login-sub {
  font-size: var(--text-sm);
  color: var(--color-ink-2);
  margin-bottom: var(--space-lg);
}

.profile-card {
  display: flex;
  align-items: center;
  gap: var(--space-md);
}
.avatar-btn {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0;
  background: transparent;
  border: 0;
  line-height: 1;
}
.avatar-btn--pressed {
  transform: scale(0.96);
}
.avatar {
  width: 128rpx;
  height: 128rpx;
  border-radius: 50%;
  background: var(--color-paper-2);
}
.avatar--empty {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--text-sm);
  color: var(--color-ink-2);
  border: 2rpx dashed var(--color-rule);
}
.profile-info {
  flex: 2;
  min-width: 0;
}
.nickname-input {
  font-size: var(--text-md);
  font-weight: 700;
  height: 72rpx;
}
.profile-tip {
  font-size: var(--text-xs);
  color: var(--color-neutral);
  font-family: var(--font-label);
}

.menu-card {
  padding: var(--space-2xs);
}
.menu-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: var(--space-md) var(--space-sm);
  border-radius: var(--radius-input);
  transition: background-color var(--dur-short) var(--ease-out);
}
.menu-row + .menu-row {
  border-top: 2rpx solid var(--color-rule);
}
.menu-title {
  font-size: var(--text-base);
  font-weight: 600;
}


.menu-arrow {
  font-size: var(--text-lg);
  color: var(--color-neutral);
}
.menu-row--pressed {
  background: var(--color-paper-2);
}

.modal-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(18, 23, 27, 0.45);
  z-index: var(--z-modal);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: var(--space-lg);
}
.modal {
  width: 100%;
  max-width: 640rpx;
  background: var(--color-card);
  border: 2rpx solid var(--color-rule);
  border-radius: var(--radius-card);
  padding: var(--space-lg);
  box-shadow: 0 24rpx 48rpx -16rpx var(--color-shadow);
}
.modal-title {
  font-size: var(--text-md);
  font-weight: 700;
  text-align: center;
  margin-bottom: var(--space-md);
}
.faq-list {
  max-height: 60vh;
  overflow-y: auto;
}
.faq-item {
  margin-bottom: var(--space-md);
}
.faq-q {
  font-size: var(--text-base);
  font-weight: 600;
}
.faq-a {
  font-size: var(--text-sm);
  color: var(--color-ink-2);
  margin-top: var(--space-2xs);
}
.modal-btn {
  margin-top: var(--space-sm);
}
.about-logo {
  width: 120rpx;
  height: 120rpx;
  border-radius: 32rpx;
  background: var(--color-accent);
  color: var(--color-accent-ink);
  font-size: var(--text-md);
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto var(--space-sm);
  box-shadow: 0 8rpx 0 0 var(--color-accent-deep);
}
.about-name {
  text-align: center;
  font-size: var(--text-md);
  font-weight: 700;
}
.about-desc {
  text-align: center;
  font-size: var(--text-sm);
  color: var(--color-ink-2);
  margin-top: var(--space-sm);
}
.about-version {
  text-align: center;
  font-size: var(--text-xs);
  color: var(--color-neutral);
  margin-top: var(--space-xs);
}
