<view class="page">
  <block wx:if="{{!user}}">
    <view class="card login-card">
      <view class="login-title">登录后使用创意生成</view>
      <view class="login-sub">登录后可保存图纸到图库，并使用创意生成功能</view>
      <button class="btn btn--primary btn--lg" hover-class="btn--pressed" loading="{{loading}}" bindtap="onLogin">微信一键登录</button>
    </view>
  </block>
  <block wx:else>
    <view class="card profile-card">
      <button class="avatar-btn" open-type="chooseAvatar" hover-class="avatar-btn--pressed" bindchooseavatar="onChooseAvatar">
        <image wx:if="{{(avatarPreview || user.avatarFileID) && !avatarBroken}}" class="avatar" src="{{avatarPreview || user.avatarFileID}}" mode="aspectFill" binderror="onAvatarError" />
        <view wx:else class="avatar avatar--empty">设头像</view>
      </button>
      <view class="profile-info">
        <input
          class="nickname-input"
          type="nickname"
          placeholder="点击设置昵称"
          value="{{user.nickname}}"
          bindblur="onNicknameBlur"
          bindconfirm="onNicknameBlur"
          confirm-type="done"
        />
        <view class="profile-tip">ID：{{openidTail}}</view>
      </view>
    </view>

    <view class="card menu-card">
    <view class="menu-row" hover-class="menu-row--pressed" bindtap="goGallery">
      <view class="menu-title">我的图库</view>
      <view class="menu-arrow">›</view>
    </view>
    <view class="menu-row" hover-class="menu-row--pressed" bindtap="showFaq">
      <view class="menu-title">常见问题</view>
      <view class="menu-arrow">›</view>
    </view>
    <view class="menu-row" hover-class="menu-row--pressed" bindtap="goFeedback">
      <view class="menu-title">意见反馈</view>
      <view class="menu-arrow">›</view>
    </view>
    <view class="menu-row" hover-class="menu-row--pressed" bindtap="onLogout">
      <view class="menu-title">退出登录</view>
      <view class="menu-arrow">›</view>
    </view>
    </view>

    <view class="modal-mask" wx:if="{{faqShow}}" bindtap="hideFaq">
      <view class="modal" catchtap="noop">
        <view class="modal-title">常见问题</view>
        <view class="faq-list">
          <view class="faq-item" wx:for="{{faqList}}" wx:key="q">
            <view class="faq-q">{{item.q}}</view>
            <view class="faq-a">{{item.a}}</view>
          </view>
        </view>
        <button class="btn btn--primary modal-btn" hover-class="btn--pressed" bindtap="hideFaq">我知道了</button>
      </view>
    </view>
  </block>
</view>
