/* Hallmark · macrostructure: Workbench · theme: Hum · genre: playful */
@import "../../styles/tokens.wxss";
@import "../../styles/progress.wxss";

.page {
  padding: var(--space-xl) var(--space-md) calc(100rpx + env(safe-area-inset-bottom) + var(--space-lg));
}

.hero {
  padding: var(--space-xs) 0 var(--space-lg);
}
.hero-title {
  font-family: var(--font-display);
  font-size: var(--text-xl);
  font-weight: 600;
  letter-spacing: -0.025em;
  color: var(--color-ink);
}
.hero-sub {
  margin-top: var(--space-2xs);
  font-size: var(--text-sm);
  color: var(--color-ink-2);
}

.scan-entry {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: var(--color-accent);
  border-color: var(--color-accent-deep);
  box-shadow: 0 12rpx 32rpx -16rpx var(--color-cast);
}
.scan-entry--pressed {
  transform: translateY(2rpx) scale(0.985);
}
.scan-entry-title {
  font-size: var(--text-md);
  font-weight: 600;
  color: var(--color-accent-ink);
}
.scan-entry-sub {
  margin-top: 4rpx;
  font-size: var(--text-sm);
  color: var(--color-accent-ink);
  opacity: 0.75;
}
.scan-entry-arrow {
  font-size: 56rpx;
  line-height: 1;
  color: var(--color-accent-ink);
  padding-left: var(--space-md);
}

.card {
  background: var(--color-card);
  border: 2rpx solid var(--color-rule);
  border-radius: var(--radius-card);
  box-shadow: 0 12rpx 32rpx -16rpx var(--color-shadow);
  margin-bottom: var(--space-md);
  padding: var(--space-md);
  transition: transform var(--dur-micro) var(--ease-out);
}

.import-card {
  min-height: 320rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border: 3rpx dashed var(--color-rule);
  border-radius: var(--radius-card);
  background: var(--color-paper-2);
  box-shadow: none;
  overflow: hidden;
}
.import-card--pressed {
  transform: translateY(2rpx) scale(0.985);
}
.import-card.has-image {
  border-style: solid;
  background: var(--color-card);
  box-shadow: 0 12rpx 32rpx -16rpx var(--color-shadow);
}
.bead {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: radial-gradient(circle at 32% 28%, var(--color-bead-hi) 0 18%, var(--color-accent) 58%, var(--color-accent-deep) 100%);
  box-shadow: inset 0 -10rpx 14rpx var(--color-cast-strong);
  animation: bead-breathe 4s ease-in-out infinite;
}
@keyframes bead-breathe {
  0%, 100% { transform: scale(1); }
  50% { transform: scale(1.06); }
}
@media (prefers-reduced-motion: reduce) {
  .bead { animation: none; }
}
.import-title {
  margin-top: var(--space-md);
  font-size: var(--text-md);
  font-weight: 600;
  color: var(--color-ink);
}
.import-sub {
  margin-top: var(--space-2xs);
  font-size: var(--text-sm);
  color: var(--color-ink-2);
}
.import-img {
  width: 100%;
  height: 420rpx;
  border-radius: var(--radius-input);
}
.import-again {
  margin-top: var(--space-sm);
  font-size: var(--text-sm);
  color: var(--color-ink-2);
}

.section-title {
  font-size: var(--text-sm);
  font-weight: 600;
  color: var(--color-ink-2);
  margin-bottom: var(--space-sm);
}

.chip-row {
  display: flex;
  gap: var(--space-xs);
}
.chip {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  border-radius: var(--radius-pill);
  background: var(--color-paper);
  border: 2rpx solid var(--color-rule);
  font-size: var(--text-sm);
  color: var(--color-ink-2);
  transition: background-color var(--dur-short) var(--ease-out), color var(--dur-short) var(--ease-out), border-color var(--dur-short) var(--ease-out), transform var(--dur-micro) var(--ease-out);
}
.chip--on {
  background: var(--color-ink);
  border-color: var(--color-ink);
  color: var(--color-paper);
  font-weight: 600;
}
.chip--pressed {
  transform: translateY(2rpx) scale(0.94);
}

.generate {
  margin-top: var(--space-lg);
}


.chip-row--wrap {
  flex-wrap: wrap;
  gap: var(--space-xs);
}
.chip--auto {
  flex: none;
  padding: 16rpx 30rpx;
}
.chip--disabled {
  opacity: 0.35;
  pointer-events: none;
}
.style-input {
  margin-top: var(--space-sm);
  padding: 20rpx 24rpx;
  border-radius: var(--radius-input);
  background: var(--color-paper-2);
  border: 2rpx solid var(--color-rule);
  font-size: var(--text-sm);
  color: var(--color-ink);
}
.section-hint {
  margin-top: var(--space-2xs);
  font-size: var(--text-xs);
  color: var(--color-ink-2);
}
.switch-row {
  margin-top: var(--space-md);
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.switch-label {
  font-size: var(--text-sm);
  color: var(--color-ink);
}
.size-controls {
  display: flex;
  align-items: center;
  gap: var(--space-sm);
  margin-top: var(--space-sm);
}
.size-btn {
  width: 64rpx;
  height: 64rpx;
  flex: none;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: var(--color-paper-2);
  border: 2rpx solid var(--color-rule);
  font-size: var(--text-md);
  font-weight: 600;
  color: var(--color-ink);
  transition: background-color var(--dur-short) var(--ease-out), transform var(--dur-micro) var(--ease-out);
}
.size-btn--pressed {
  background: var(--color-paper-3);
  transform: scale(0.94);
}
.size-slider {
  flex: 1;
}
.size-input {
  width: 120rpx;
  padding: 12rpx 16rpx;
  text-align: center;
  border-radius: var(--radius-input);
  background: var(--color-paper-2);
  border: 2rpx solid var(--color-rule);
  font-family: var(--font-label);
  font-size: var(--text-sm);
  color: var(--color-ink);
}


/* ---- 创意生成选项弹层（甜度选择式底部弹层）---- */
.ai-summary {
  margin-top: var(--space-sm);
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18rpx 24rpx;
  border-radius: var(--radius-input);
  background: var(--color-paper-2);
  border: 2rpx solid var(--color-rule);
  font-size: var(--text-xs);
  color: var(--color-ink-2);
  transition: transform var(--dur-micro) var(--ease-out);
}
.ai-summary--pressed {
  transform: translateY(2rpx) scale(0.985);
}
.ai-summary-text {
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.ai-summary-arrow {
  flex: none;
  font-size: 36rpx;
  line-height: 1;
  color: var(--color-ink-2);
  padding-left: var(--space-sm);
}
.ai-summary-edit {
  flex: none;
  margin-left: var(--space-sm);
  padding: 8rpx 18rpx;
  border-radius: var(--radius-pill);
  background: var(--color-accent);
  color: var(--color-accent-ink);
  font-size: var(--text-xs);
  font-weight: 600;
  line-height: 1;
}
.ai-sheet-mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 1500; /* 盖过自定义 tabBar(999)，低于引导层(3000) */
  background: rgba(18, 23, 27, 0.45);
  animation: ai-mask-in 200ms var(--ease-out);
}
.ai-sheet-mask--leave {
  animation: ai-mask-out 200ms var(--ease-in) forwards;
}
.ai-sheet {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 86vh;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  background: var(--color-card);
  border-radius: var(--radius-card) var(--radius-card) 0 0;
  padding: 0 var(--space-md) calc(var(--space-md) + env(safe-area-inset-bottom));
  animation: ai-sheet-in 260ms var(--ease-drawer);
}
.ai-sheet--leave {
  animation: ai-sheet-out 200ms var(--ease-in) forwards;
}
@keyframes ai-mask-in {
  from { opacity: 0; }
  to { opacity: 1; }
}
@keyframes ai-mask-out {
  from { opacity: 1; }
  to { opacity: 0; }
}
@keyframes ai-sheet-in {
  from { transform: translateY(100%); }
  to { transform: translateY(0); }
}
@keyframes ai-sheet-out {
  from { transform: translateY(0); }
  to { transform: translateY(100%); }
}
.ai-sheet-grab {
  flex: none;
  padding-top: var(--space-2xs);
}
.ai-sheet-handle {
  flex: none;
  width: 72rpx;
  height: 8rpx;
  border-radius: var(--radius-pill);
  background: var(--color-rule);
  margin: var(--space-sm) auto 0;
}
.ai-sheet-head {
  flex: none;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: var(--space-sm) 0 var(--space-xs);
}
.ai-sheet-title {
  font-size: var(--text-md);
  font-weight: 700;
  color: var(--color-ink);
}
.ai-sheet-scroll {
  flex: 1 1 0;
  min-height: 0;
  height: 0; /* 固定高度配合 flex 撑满，scroll-view 才有界可下滑 */
}
.ai-sheet-section {
  padding: var(--space-sm) 0;
  border-bottom: 2rpx solid var(--color-rule);
}
.ai-sheet-section:last-child {
  border-bottom: 0;
}
.ai-sheet-done {
  flex: none;
  margin-top: var(--space-sm);
}
