<view class="page">
  <view class="meta card">
    <view class="meta-item">
      <text class="meta-label">色系</text>
      <text class="meta-value">{{set}} 色</text>
    </view>
    <view class="meta-item">
      <text class="meta-label">拼豆盘</text>
      <text class="meta-value">{{size}}×{{size}}</text>
    </view>
    <view class="meta-item">
      <text class="meta-label">生成方式</text>
      <text class="meta-value">{{mode === 'ai' ? '创意生成·' + styleShort : '照片还原'}}</text>
    </view>
  </view>

  <view class="canvas-shell card">
    <view class="canvas-area" id="canvasArea" bindtouchstart="onTouchStart" catchtouchmove="onTouchMove" bindtouchend="onTouchEnd" bindtouchcancel="onTouchCancel">
      <canvas type="2d" id="patternCanvas" class="pattern-canvas" style="width: 100%; height: 100%;" />
    </view>
    <view class="canvas-hint">双指缩放 · 拖动查看</view>
  </view>

  <view class="grid-opt card">
    <view class="opt-row">
      <text class="opt-label">网格线</text>
      <switch checked="{{gridOn}}" color="#009fef" bindchange="onGridToggle" />
    </view>
    <view class="opt-row">
      <text class="opt-label">网格密度</text>
      <view class="seg {{gridOn ? '' : 'seg--disabled'}}">
        <view wx:for="{{[5, 10, 20]}}" wx:key="*this" class="seg-item {{gridEvery === item ? 'seg-item--on' : ''}}" data-value="{{item}}" bindtap="onGridEvery">每 {{item}} 格</view>
      </view>
    </view>
  </view>

  <view class="legend card">
    <view class="legend-head">
      <view class="section-title">用到的颜色</view>
      <view class="legend-total">共 {{total}} 格</view>
    </view>
    <view class="legend-list">
      <view wx:for="{{legend}}" wx:key="code" class="legend-item">
        <view class="legend-swatch" style="background: {{item.hex}}"></view>
        <text class="legend-code">{{item.code}}</text>
        <text class="legend-count">× {{item.count}}</text>
      </view>
    </view>
  </view>

  <view class="action-bar">
    <button class="btn btn--soft action-btn" hover-class="btn--pressed" bindtap="goEdit">进入修改</button>
    <button class="btn btn--primary action-btn" hover-class="btn--pressed" bindtap="exportImage">导出图片</button>
  </view>
</view>
