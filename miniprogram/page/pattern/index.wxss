/* Hallmark · macrostructure: Workbench · theme: Hum · genre: playful */
@import "../../styles/tokens.wxss";
@import "../../styles/progress.wxss";
@import "../../styles/beading.wxss";

.page {
  padding: var(--space-md) var(--space-md) calc(180rpx + 48rpx);
}
.card {
  background: var(--color-card);
  border: 2rpx solid var(--color-rule);
  border-radius: var(--radius-card);
  box-shadow: 0 12rpx 32rpx -16rpx var(--color-shadow);
  margin-bottom: var(--space-md);
  padding: var(--space-md);
}
.section-title {
  font-size: var(--text-sm);
  font-weight: 600;
  color: var(--color-ink-2);
  margin-bottom: var(--space-sm);
}

.meta {
  display: flex;
  flex-wrap: wrap;
  align-items: baseline;
  gap: var(--space-sm) var(--space-lg);
  padding: var(--space-sm) var(--space-md);
}
.meta-item {
  display: flex;
  align-items: baseline;
  gap: var(--space-2xs);
  white-space: nowrap;
}
.meta-label {
  font-size: var(--text-xs);
  color: var(--color-ink-2);
}
.meta-value {
  font-family: var(--font-label);
  font-size: var(--text-sm);
  font-weight: 600;
  color: var(--color-ink);
}

.canvas-shell {
  padding: var(--space-sm);
}
.canvas-area {
  width: 100%;
  aspect-ratio: 1 / 1;
  border-radius: var(--radius-input);
  background: var(--color-paper-2);
  overflow: hidden;
}
.canvas-view {
}
.pattern-canvas {
  display: block;
}

.canvas-hint {
  margin-top: var(--space-2xs);
  text-align: center;
  font-size: var(--text-xs);
  color: var(--color-ink-2);
}

.legend-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: var(--space-sm);
}
.legend-total {
  font-family: var(--font-label);
  font-size: var(--text-xs);
  color: var(--color-ink-2);
}
.legend-list {
  display: flex;
  flex-wrap: wrap;
  gap: 6rpx;
}
.legend-item {
  display: flex;
  align-items: center;
  gap: 6rpx;
  padding: 6rpx 12rpx;
  border-radius: var(--radius-pill);
  background: var(--color-paper-2);
}
.legend-swatch {
  width: 28rpx;
  height: 28rpx;
  border-radius: 50%;
  border: 2rpx solid var(--color-rule);
}
.legend-code {
  font-family: var(--font-label);
  font-size: var(--text-xs);
  color: var(--color-ink);
  font-weight: 600;
}
.legend-count {
  font-family: var(--font-label);
  font-size: var(--text-xs);
  color: var(--color-ink-2);
}

.grid-opt {
  padding: var(--space-sm) var(--space-md);
}
.opt-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 72rpx;
  gap: var(--space-sm);
}
.opt-row + .opt-row {
  margin-top: var(--space-2xs);
}
.opt-label {
  font-size: var(--text-sm);
  color: var(--color-ink);
  flex-shrink: 0;
}
.seg {
  flex: 1;
  display: flex;
  gap: var(--space-2xs);
  padding: 6rpx;
  border-radius: var(--radius-pill);
  background: var(--color-paper-2);
}
.seg-item {
  flex: 1;
  padding: 10rpx 0;
  text-align: center;
  font-size: var(--text-xs);
  color: var(--color-ink-2);
  border-radius: var(--radius-pill);
  transition: background-color var(--dur-short) var(--ease-out), color var(--dur-short) var(--ease-out);
}
.seg-item--on {
  background: var(--color-ink);
  color: var(--color-paper);
  font-weight: 600;
}
.seg--disabled {
  opacity: 0.45;
}

.action-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  gap: var(--space-sm);
  padding: var(--space-sm) var(--space-md) calc(var(--space-sm) + env(safe-area-inset-bottom));
  background: var(--color-paper);
  box-shadow: 0 -8rpx 24rpx -16rpx var(--color-shadow);
  z-index: var(--z-sticky);
}
.action-btn {
  flex: 1;
}
.version-bar {
  display: flex;
  align-items: center;
  gap: var(--space-sm);
  padding: var(--space-sm) var(--space-md);
}
.version-info {
  font-family: var(--font-label);
  font-size: var(--text-sm);
  font-weight: 600;
  color: var(--color-ink);
  flex-shrink: 0;
}
.version-actions {
  flex: 1;
  display: flex;
  gap: var(--space-2xs);
}
.version-actions .action-btn {
  flex: none;
  width: 200rpx; /* 紧凑固定宽度，避免默认按钮样式（外边距/最小宽）撑破页面 */
  min-width: 0;
  height: 72rpx;
  margin: 0;
  padding: 0 var(--space-xs);
  font-size: var(--text-sm);
  white-space: nowrap;
  line-height: 1;
}
.regenerate {
  padding: var(--space-sm) var(--space-md);
}
.regenerate-input {
  width: 100%;
  box-sizing: border-box;
  height: 88rpx;
  line-height: 88rpx;
  margin-bottom: var(--space-sm);
  padding: 0 24rpx;
  border-radius: var(--radius-input);
  background: var(--color-paper-2);
  border: 2rpx solid var(--color-rule);
  font-size: var(--text-sm);
  color: var(--color-ink);
}


/* 图纸网格区域：更干净的画布卡纸观感 */
.canvas-shell {
  padding: 10rpx;
  border: 2rpx solid var(--color-rule);
  border-radius: 32rpx;
  background: linear-gradient(180deg, #fffdf7 0%, #f4f1e8 100%);
  box-shadow: 0 18rpx 36rpx -24rpx rgba(18, 23, 27, 0.25);
}
.canvas-area {
  aspect-ratio: 1 / 1;
  border: 2rpx solid var(--color-rule);
  border-radius: 30rpx;
  background:
    radial-gradient(circle at 1px 1px, rgba(18, 23, 27, 0.08) 1rpx, transparent 0) 0 0 / 28rpx 28rpx,
    #ffffff;
  box-shadow: inset 0 8rpx 20rpx -16rpx rgba(18, 23, 27, 0.22);
  overflow: hidden;
}
