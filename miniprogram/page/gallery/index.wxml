<view class="page">
  <view class="gallery-head">我的图库 · 共 {{total}} 张 · 第 {{page}}/{{totalPages}} 页</view>
  <view wx:if="{{items.length}}" class="gallery-grid">
    <view wx:for="{{items}}" wx:key="_id" class="pair-card">
      <view class="pair-thumbs">
        <view class="thumb-box">
          <image class="thumb" src="{{item.originalThumbFileID || item.originalFileID}}" mode="aspectFit" lazy-load data-fileid="{{item.originalFileID}}" bindtap="onPreview" />
        </view>
        <view class="thumb-box">
          <image class="thumb" src="{{item.patternThumbFileID || item.patternFileID}}" mode="aspectFit" lazy-load data-id="{{item._id}}" bindtap="onPatternPreview" />
        </view>
      </view>
      <view class="pair-meta">
        <text class="pair-style">{{item.mode === 'ai' ? '创意生成 · ' + item.styleShort : '照片还原'}}</text>
        <text class="pair-sub">{{item.timeText}} · {{item.size}}×{{item.size}} · {{item.set}} 色</text>
      </view>
      <view class="pair-actions">
        <button class="btn btn--soft btn--sm" hover-class="btn--pressed" data-id="{{item._id}}" bindtap="onExport">导出</button>
        <button class="btn btn--soft btn--sm" hover-class="btn--pressed" data-id="{{item._id}}" bindtap="onEdit">编辑</button>
        <button class="btn btn--soft btn--sm btn--danger" hover-class="btn--pressed" data-id="{{item._id}}" bindtap="onDelete">删除</button>
      </view>
    </view>
  </view>
  <view wx:else class="empty">还没有图纸，去首页生成一张吧</view>

  <view wx:if="{{totalPages > 1}}" class="pager">
    <view class="pager-btn {{page === 1 ? 'pager-btn--disabled' : ''}}" data-page="{{page - 1}}" bindtap="goPage">上一页</view>
    <view
      wx:for="{{pageNos}}"
      wx:key="*this"
      class="pager-num {{item === page ? 'pager-num--on' : ''}} {{item === '...' ? 'pager-dot' : ''}}"
      data-page="{{item}}"
      bindtap="goPage"
    >{{item}}</view>
    <view class="pager-btn {{page === totalPages ? 'pager-btn--disabled' : ''}}" data-page="{{page + 1}}" bindtap="goPage">下一页</view>
  </view>
</view>
