@import "../../styles/tokens.wxss";

.page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: var(--color-ink);
  padding: var(--space-sm) var(--space-md) calc(var(--space-sm) + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.stage {
  flex: 1;
  min-height: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}
.crop-area {
  position: relative;
  background: var(--color-paper-3);
}
.crop-img {
  display: block;
}
.crop-frame {
  position: absolute;
  box-sizing: border-box;
  border: 2rpx solid var(--color-accent);
  background: rgba(247, 245, 236, 0.06);
}
.crop-grid {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background-image:
    linear-gradient(rgba(255, 255, 255, 0.25) 1px, transparent 1px),
    linear-gradient(90deg, rgba(255, 255, 255, 0.25) 1px, transparent 1px);
  background-size: 33.33% 33.33%;
}
.handle {
  position: absolute;
  background: transparent;
}
.handle--tl { left: -14rpx; top: -14rpx; width: 28rpx; height: 28rpx; border-left: 6rpx solid var(--color-accent); border-top: 6rpx solid var(--color-accent); }
.handle--tr { right: -14rpx; top: -14rpx; width: 28rpx; height: 28rpx; border-right: 6rpx solid var(--color-accent); border-top: 6rpx solid var(--color-accent); }
.handle--bl { left: -14rpx; bottom: -14rpx; width: 28rpx; height: 28rpx; border-left: 6rpx solid var(--color-accent); border-bottom: 6rpx solid var(--color-accent); }
.handle--br { right: -14rpx; bottom: -14rpx; width: 28rpx; height: 28rpx; border-right: 6rpx solid var(--color-accent); border-bottom: 6rpx solid var(--color-accent); }
.handle--l { left: -14rpx; top: 28rpx; bottom: 28rpx; width: 28rpx; }
.handle--r { right: -14rpx; top: 28rpx; bottom: 28rpx; width: 28rpx; }
.handle--t { top: -14rpx; left: 28rpx; right: 28rpx; height: 28rpx; }
.handle--b { bottom: -14rpx; left: 28rpx; right: 28rpx; height: 28rpx; }

.controls {
  padding-top: var(--space-sm);
}
.hint {
  font-size: var(--text-xs);
  color: var(--color-paper);
  opacity: 0.75;
  text-align: center;
  margin-bottom: var(--space-sm);
}
.actions {
  display: flex;
  gap: var(--space-sm);
}
.actions .btn {
  flex: 1;
}

.crop-canvas {
  position: fixed;
  left: -9999px;
  top: 0;
}