<view class="page">
  <view class="stage">
    <view class="crop-area" id="cropArea" style="width: {{imgW}}px; height: {{imgH}}px;">
      <image class="crop-img" src="{{sourcePath}}" style="width: {{imgW}}px; height: {{imgH}}px;" mode="aspectFill" />
      <view
        class="crop-frame"
        style="left: {{frameX}}px; top: {{frameY}}px; width: {{frameW}}px; height: {{frameH}}px;"
        catchtouchstart="onFrameTouchStart"
        catchtouchmove="onFrameTouchMove"
        catchtouchend="onFrameTouchEnd"
      >
        <view class="crop-grid"></view>
        <view class="handle handle--tl"></view>
        <view class="handle handle--tr"></view>
        <view class="handle handle--bl"></view>
        <view class="handle handle--br"></view>
        <view wx:if="{{edgesReady}}" class="handle handle--l"></view>
        <view wx:if="{{edgesReady}}" class="handle handle--r"></view>
        <view wx:if="{{edgesReady}}" class="handle handle--t"></view>
        <view wx:if="{{edgesReady}}" class="handle handle--b"></view>
      </view>
    </view>
  </view>

  <view class="controls">
    <view class="ratios">
    <view class="ratio-option {{ratio === '1:1' ? 'ratio-option--on' : ''}}" data-ratio="1:1" bindtap="onRatioTap">1:1</view>
    <view class="ratio-option {{ratio === '4:3' ? 'ratio-option--on' : ''}}" data-ratio="4:3" bindtap="onRatioTap">4:3</view>
    <view class="ratio-option {{ratio === '3:4' ? 'ratio-option--on' : ''}}" data-ratio="3:4" bindtap="onRatioTap">3:4</view>
    <view class="ratio-option {{ratio === 'free' ? 'ratio-option--on' : ''}}" data-ratio="free" bindtap="onRatioTap">自由</view>
  </view>
  <view class="hint">{{hint}}</view>
    <view class="actions">
      <button class="btn btn--soft" hover-class="btn--pressed" bindtap="cancel">取消</button>
      <button class="btn btn--primary" hover-class="btn--pressed" bindtap="confirm">完成</button>
    </view>
  </view>

  <canvas type="2d" id="cropCanvas" class="crop-canvas" style="width: 0px; height: 0px;" />
</view>