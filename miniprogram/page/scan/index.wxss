/* 图纸识别（扫描）：固定网格 + 移图 */
@import "../../styles/tokens.wxss";

.page {
  min-height: 100vh;
}

.hero {
  padding: var(--space-lg) var(--space-md) var(--space-md);
  /* 深色极光玻璃（与主页横条一致） */
  background-image: linear-gradient(115deg, #1a2030 0%, #2c3a6e 16%, #5a4fc0 34%, #3e8fc9 52%, #7a5fd0 70%, #2c3a6e 86%, #1a2030 100%);
  background-size: 300% 300%;
  animation: glass-flow 8s ease-in-out infinite;
  border-bottom: 2rpx solid rgba(255, 255, 255, 0.35);
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.4);
}
@keyframes glass-flow {
  0% { background-position: 0% 50%; }
  50% { background-position: 100% 50%; }
  100% { background-position: 0% 50%; }
}
.hero-title {
  font-family: var(--font-display);
  font-size: var(--text-xl);
  font-weight: 600;
  letter-spacing: -0.025em;
  color: #e6c4fe;
}
.hero-sub {
  margin-top: var(--space-2xs);
  font-size: var(--text-sm);
  color: rgba(255, 255, 255, 0.76);
}

.card {
  background: var(--color-card);
  border: 5rpx solid #12171b;
  border-radius: var(--radius-card);
  box-shadow: 8rpx 8rpx 0 var(--color-cast);
  margin: 0 var(--space-md) var(--space-md);
  padding: var(--space-md);
  transition: transform var(--dur-micro) var(--ease-out);
}

.import-card {
  min-height: 320rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border: 5rpx solid #12171b;
  border-radius: var(--radius-card);
  background: #ffffff;
  box-shadow: 10rpx 10rpx 0 rgba(18, 23, 27, 0.42);
  overflow: hidden;
}
.import-card--pressed {
  transform: translateY(2rpx) scale(0.985);
}
.bead {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: radial-gradient(circle at 32% 28%, var(--color-bead-hi) 0 18%, var(--color-accent) 58%, var(--color-accent-deep) 100%);
  box-shadow: inset 0 -10rpx 14rpx var(--color-cast-strong);
  animation: bead-breathe 4s ease-in-out infinite;
}
@keyframes bead-breathe {
  0%, 100% { transform: scale(1); }
  50% { transform: scale(1.06); }
}
.import-title {
  margin-top: var(--space-md);
  font-size: var(--text-md);
  font-weight: 600;
  color: var(--color-ink);
}
.import-sub {
  margin-top: var(--space-2xs);
  font-size: var(--text-sm);
  color: var(--color-ink-2);
}

.hint-card {
  margin-top: var(--space-lg);
}
.section-title {
  font-size: var(--text-sm);
  font-weight: 600;
  color: var(--color-ink-2);
  margin-bottom: var(--space-sm);
}
.hint-line {
  font-size: var(--text-sm);
  color: var(--color-ink-2);
  line-height: 1.7;
}

.calibrate {
  display: flex;
  flex-direction: column;
  height: 100vh;
}
.canvas-wrap {
  flex: 1;
  position: relative;
  min-height: 0;
  margin: 24rpx;
  border-radius: var(--radius-input);
  overflow: hidden;
  background: var(--color-paper-3);
}
.scan-canvas {
  width: 100%;
  height: 100%;
}
.canvas-tip {
  position: absolute;
  top: var(--space-xs);
  left: 0;
  right: 0;
  text-align: center;
  font-size: 22rpx;
  color: var(--color-ink-2);
  pointer-events: none;
}

.panel {
  padding: var(--space-sm) var(--space-md) calc(var(--space-md) + env(safe-area-inset-bottom));
  background: var(--color-card);
  border-top: 5rpx solid #12171b;
}

.cells-row {
  margin-bottom: var(--space-sm);
}
.cells-label {
  display: block;
  font-size: var(--text-sm);
  font-weight: 600;
  color: var(--color-ink-2);
  margin-bottom: var(--space-2xs);
}
.cells-control {
  display: flex;
  align-items: center;
  gap: var(--space-xs);
}
.cells-btn {
  min-width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: var(--radius-input);
  background: #ffffff;
  border: 3rpx solid #12171b;
  font-size: var(--text-md);
  color: var(--color-ink);
}
.cells-slider {
  flex: 1;
}
.cells-value {
  min-width: 96rpx;
  text-align: center;
  font-size: var(--text-sm);
  color: var(--color-ink);
}
.cells-hint {
  margin-top: var(--space-2xs);
  font-size: var(--text-xs);
  color: var(--color-neutral);
}

.chip-row {
  display: flex;
  gap: var(--space-xs);
  margin-bottom: var(--space-sm);
}
.chip {
  flex: 1;
  text-align: center;
  padding: 18rpx 0;
  border-radius: var(--radius-pill);
  background: #ffffff;
  border: 3rpx solid #12171b;
  font-size: var(--text-sm);
  color: var(--color-ink-2);
  transition: background-color var(--dur-short) var(--ease-out), color var(--dur-short) var(--ease-out), border-color var(--dur-short) var(--ease-out), transform var(--dur-micro) var(--ease-out);
}
.chip--on {
  /* 浅色磨砂玻璃：选中 chip 不再纯黑 */
  background-image: linear-gradient(115deg, rgba(255, 255, 255, 0.85) 0%, rgba(219, 209, 255, 0.78) 24%, rgba(181, 226, 255, 0.72) 50%, rgba(228, 206, 255, 0.78) 76%, rgba(255, 255, 255, 0.85) 100%);
  background-size: 300% 300%;
  animation: glass-flow 8s ease-in-out infinite;
  border-color: var(--color-ink);
  color: #12171b;
  font-weight: 600;
}
.chip--pressed {
  transform: translateY(2rpx) scale(0.96);
}

.switch-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: var(--space-sm);
}
.switch-label {
  font-size: var(--text-sm);
  color: var(--color-ink-2);
}

.nudge-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--space-sm);
  margin-bottom: var(--space-sm);
}
.nudge-left {
  display: flex;
  flex-direction: column;
  gap: var(--space-xs);
  flex: 1;
  min-width: 0;
}
.nudge-label {
  font-size: var(--text-sm);
  font-weight: 600;
  color: var(--color-ink);
}
.nudge-tools {
  display: flex;
  gap: var(--space-2xs);
}
.mini-btn {
  height: 56rpx;
  padding: 0 var(--space-md);
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: var(--radius-pill);
  background: #ffffff;
  border: 3rpx solid #12171b;
  font-size: var(--text-xs);
  color: var(--color-ink-2);
  transition: transform var(--dur-micro) var(--ease-out), background-color var(--dur-short) var(--ease-out);
}
.mini-btn--pressed {
  transform: translateY(2rpx) scale(0.95);
  background: var(--color-paper-3);
}

/* 十字方向键：四个箭头用 CSS chevron，等大、跨端一致（不用平台 Unicode 箭头） */
.dpad {
  display: grid;
  grid-template-columns: repeat(3, 60rpx);
  grid-template-rows: repeat(3, 60rpx);
  gap: 6rpx;
  flex: none;
}
.dpad-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: var(--radius-input);
  background: #ffffff;
  border: 3rpx solid #12171b;
  transition: transform var(--dur-micro) var(--ease-out), background-color var(--dur-short) var(--ease-out);
}
.dpad-btn--up { grid-column: 2; grid-row: 1; }
.dpad-btn--left { grid-column: 1; grid-row: 2; }
.dpad-btn--right { grid-column: 3; grid-row: 2; }
.dpad-btn--down { grid-column: 2; grid-row: 3; }
.dpad-btn--pressed {
  transform: translateY(2rpx) scale(0.93);
  background: var(--color-paper-3);
}
.chev {
  width: 16rpx;
  height: 16rpx;
  border-right: 4rpx solid var(--color-ink);
  border-bottom: 4rpx solid var(--color-ink);
  border-radius: 2rpx;
}
.zoom-col {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  flex: none;
}
.zoom-symbol {
  font-size: 34rpx;
  font-weight: 600;
  line-height: 1;
  color: var(--color-ink);
}
.chev--right { transform: rotate(-45deg); }
.chev--left { transform: rotate(135deg); }
.chev--up { transform: rotate(-135deg); }
.chev--down { transform: rotate(45deg); }

.footer-actions {
  display: flex;
  gap: var(--space-sm);
  margin-top: var(--space-md);
}
.footer-btn {
  flex: 1;
  white-space: nowrap;
  font-size: var(--text-sm);
  padding: 0 var(--space-xs);
}
.footer-btn--main {
  flex: 1.4; /* 主 CTA 更宽，与次动作形成层级 */
}
