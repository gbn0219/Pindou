/* 图纸识别（扫描）：固定网格 + 移图 */
@import "../../styles/tokens.wxss";

.page {
  min-height: 100vh;
}

.hero {
  padding: var(--space-lg) var(--space-md) var(--space-md);
}
.hero-title {
  font-family: var(--font-display);
  font-size: var(--text-xl);
  font-weight: 600;
  letter-spacing: -0.025em;
  color: var(--color-ink);
}
.hero-sub {
  margin-top: var(--space-2xs);
  font-size: var(--text-sm);
  color: var(--color-ink-2);
}

.card {
  background: var(--color-card);
  border: 2rpx solid var(--color-rule);
  border-radius: var(--radius-card);
  box-shadow: 0 12rpx 32rpx -16rpx var(--color-shadow);
  margin: 0 var(--space-md) var(--space-md);
  padding: var(--space-md);
  transition: transform var(--dur-micro) var(--ease-out);
}

.import-card {
  min-height: 320rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border: 3rpx dashed var(--color-rule);
  border-radius: var(--radius-card);
  background: var(--color-paper-2);
  box-shadow: none;
  overflow: hidden;
}
.import-card--pressed {
  transform: translateY(2rpx) scale(0.985);
}
.bead {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: radial-gradient(circle at 32% 28%, var(--color-bead-hi) 0 18%, var(--color-accent) 58%, var(--color-accent-deep) 100%);
  box-shadow: inset 0 -10rpx 14rpx var(--color-cast-strong);
  animation: bead-breathe 4s ease-in-out infinite;
}
@keyframes bead-breathe {
  0%, 100% { transform: scale(1); }
  50% { transform: scale(1.06); }
}
.import-title {
  margin-top: var(--space-md);
  font-size: var(--text-md);
  font-weight: 600;
  color: var(--color-ink);
}
.import-sub {
  margin-top: var(--space-2xs);
  font-size: var(--text-sm);
  color: var(--color-ink-2);
}

.hint-card {
  margin-top: var(--space-lg);
}
.section-title {
  font-size: var(--text-sm);
  font-weight: 600;
  color: var(--color-ink-2);
  margin-bottom: var(--space-sm);
}
.hint-line {
  font-size: var(--text-sm);
  color: var(--color-ink-2);
  line-height: 1.7;
}

.calibrate {
  display: flex;
  flex-direction: column;
  height: 100vh;
}
.canvas-wrap {
  flex: 1;
  position: relative;
  min-height: 0;
  margin: 24rpx;
  border-radius: var(--radius-input);
  overflow: hidden;
  background: var(--color-paper-3);
}
.scan-canvas {
  width: 100%;
  height: 100%;
}
.canvas-tip {
  position: absolute;
  top: var(--space-xs);
  left: 0;
  right: 0;
  text-align: center;
  font-size: 22rpx;
  color: var(--color-ink-2);
  pointer-events: none;
}

.panel {
  padding: var(--space-sm) var(--space-md) calc(var(--space-md) + env(safe-area-inset-bottom));
  background: var(--color-card);
  border-top: 2rpx solid var(--color-rule);
}

.cells-row {
  margin-bottom: var(--space-sm);
}
.cells-label {
  display: block;
  font-size: var(--text-sm);
  font-weight: 600;
  color: var(--color-ink-2);
  margin-bottom: var(--space-2xs);
}
.cells-control {
  display: flex;
  align-items: center;
  gap: var(--space-xs);
}
.cells-btn {
  min-width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: var(--radius-input);
  background: var(--color-paper);
  border: 2rpx solid var(--color-rule);
  font-size: var(--text-md);
  color: var(--color-ink);
}
.cells-slider {
  flex: 1;
}
.cells-value {
  min-width: 96rpx;
  text-align: center;
  font-size: var(--text-sm);
  color: var(--color-ink);
}
.cells-hint {
  margin-top: var(--space-2xs);
  font-size: var(--text-xs);
  color: var(--color-neutral);
}

.chip-row {
  display: flex;
  gap: var(--space-xs);
  margin-bottom: var(--space-sm);
}
.chip {
  flex: 1;
  text-align: center;
  padding: 18rpx 0;
  border-radius: var(--radius-pill);
  background: var(--color-paper);
  border: 2rpx solid var(--color-rule);
  font-size: var(--text-sm);
  color: var(--color-ink-2);
  transition: background-color var(--dur-short) var(--ease-out), color var(--dur-short) var(--ease-out), border-color var(--dur-short) var(--ease-out), transform var(--dur-micro) var(--ease-out);
}
.chip--on {
  background: var(--color-ink);
  border-color: var(--color-ink);
  color: var(--color-paper);
  font-weight: 600;
}
.chip--pressed {
  transform: translateY(2rpx) scale(0.96);
}

.switch-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: var(--space-sm);
}
.switch-label {
  font-size: var(--text-sm);
  color: var(--color-ink-2);
}

.nudge-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--space-sm);
  margin-bottom: var(--space-sm);
}
.nudge-left {
  display: flex;
  flex-direction: column;
  gap: var(--space-xs);
  flex: 1;
  min-width: 0;
}
.nudge-label {
  font-size: var(--text-sm);
  font-weight: 600;
  color: var(--color-ink);
}
.nudge-tools {
  display: flex;
  gap: var(--space-2xs);
}
.mini-btn {
  height: 56rpx;
  padding: 0 var(--space-md);
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: var(--radius-pill);
  background: var(--color-paper);
  border: 2rpx solid var(--color-rule);
  font-size: var(--text-xs);
  color: var(--color-ink-2);
  transition: transform var(--dur-micro) var(--ease-out), background-color var(--dur-short) var(--ease-out);
}
.mini-btn--pressed {
  transform: translateY(2rpx) scale(0.95);
  background: var(--color-paper-3);
}

/* 十字方向键：四个箭头用 CSS chevron，等大、跨端一致（不用平台 Unicode 箭头） */
.dpad {
  display: grid;
  grid-template-columns: repeat(3, 60rpx);
  grid-template-rows: repeat(3, 60rpx);
  gap: 6rpx;
  flex: none;
}
.dpad-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: var(--radius-input);
  background: var(--color-paper);
  border: 2rpx solid var(--color-rule);
  transition: transform var(--dur-micro) var(--ease-out), background-color var(--dur-short) var(--ease-out);
}
.dpad-btn--up { grid-column: 2; grid-row: 1; }
.dpad-btn--left { grid-column: 1; grid-row: 2; }
.dpad-btn--right { grid-column: 3; grid-row: 2; }
.dpad-btn--down { grid-column: 2; grid-row: 3; }
.dpad-btn--pressed {
  transform: translateY(2rpx) scale(0.93);
  background: var(--color-paper-3);
}
.chev {
  width: 16rpx;
  height: 16rpx;
  border-right: 4rpx solid var(--color-ink);
  border-bottom: 4rpx solid var(--color-ink);
  border-radius: 2rpx;
}
.chev--right { transform: rotate(-45deg); }
.chev--left { transform: rotate(135deg); }
.chev--up { transform: rotate(-135deg); }
.chev--down { transform: rotate(45deg); }

.footer-actions {
  display: flex;
  gap: var(--space-sm);
  margin-top: var(--space-md);
}
.footer-btn {
  flex: 1;
}
.footer-btn--main {
  flex: 1.4; /* 主 CTA 更宽，与次动作形成层级 */
}
