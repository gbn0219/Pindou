<view class="page">
  <!-- 导入阶段 -->
  <block wx:if="{{stage === 'import'}}">
    <view class="hero">
      <view class="hero-title">识别已有图纸</view>
      <view class="hero-sub">截图导入，自动对齐网格后识别成色号网格</view>
    </view>
    <view class="card import-card" hover-class="import-card--pressed" bindtap="chooseImage">
      <view class="bead" aria-hidden="true"></view>
      <view class="import-title">点击导入图纸图片</view>
      <view class="import-sub">从相册选择，或拍一张</view>
    </view>
    <view class="card hint-card">
      <view class="section-title">使用方法</view>
      <view class="hint-line">1. 导入图纸截图</view>
      <view class="hint-line">2. 调整网格格数，仅对齐参考</view>
      <view class="hint-line">3. 缩放/拖动图片让色块对齐网格，确认后识别</view>
    </view>
  </block>

  <!-- 校准阶段：固定网格 + 移图 -->
  <block wx:else>
    <view class="calibrate">
      <view class="canvas-wrap">
        <canvas
          type="2d"
          id="scanCanvas"
          class="scan-canvas"
          bindtouchstart="onTouchStart"
          catchtouchmove="onTouchMove"
          bindtouchend="onTouchEnd"
          bindtouchcancel="onTouchCancel"
        ></canvas>
        <view class="canvas-tip">{{hint}}</view>
      </view>

      <view class="panel">
        <view class="cells-row">
          <text class="cells-label">网格格数（对齐参考）</text>
          <view class="cells-control">
            <view class="cells-btn" data-delta="-1" bindtap="onCellsStep">−</view>
            <slider
              class="cells-slider"
              min="5"
              max="50"
              step="1"
              value="{{cells}}"
              activeColor="#f6ce00"
              block-size="20"
              bindchanging="onCellsChange"
              bindchange="onCellsChange"
            />
            <view class="cells-btn" data-delta="1" bindtap="onCellsStep">＋</view>
            <text class="cells-value">{{cells}} 格</text>
          </view>
          <view class="cells-hint">最终图纸尺寸按识别到的彩色区域自动确定，不需填</view>
        </view>

        <view class="chip-row">
          <view
            wx:for="{{colorSets}}"
            wx:key="*this"
            class="chip {{set === item ? 'chip--on' : ''}}"
            hover-class="chip--pressed"
            data-value="{{item}}"
            bindtap="pickSet"
          >{{item}} 色</view>
        </view>

        <view class="switch-row">
          <text class="switch-label">背景自动识别（无标号白格置空）</text>
          <switch checked="{{autoBg}}" color="#ff3a5d" bindchange="onAutoBgChange" />
        </view>

        <view class="nudge-row">
          <view class="nudge-left">
            <text class="nudge-label">对齐微调</text>
            <view class="nudge-tools">
              <view class="mini-btn" hover-class="mini-btn--pressed" bindtap="onAutoAlign">{{autoAligning ? '对齐中…' : '自动对齐'}}</view>
              <view class="mini-btn" hover-class="mini-btn--pressed" bindtap="resetAlign">重置对齐</view>
            </view>
          </view>
          <view class="dpad">
            <view class="dpad-btn dpad-btn--up" hover-class="dpad-btn--pressed" data-dir="up" bindtap="onNudge"><view class="chev chev--up"></view></view>
            <view class="dpad-btn dpad-btn--left" hover-class="dpad-btn--pressed" data-dir="left" bindtap="onNudge"><view class="chev chev--left"></view></view>
            <view class="dpad-btn dpad-btn--down" hover-class="dpad-btn--pressed" data-dir="down" bindtap="onNudge"><view class="chev chev--down"></view></view>
            <view class="dpad-btn dpad-btn--right" hover-class="dpad-btn--pressed" data-dir="right" bindtap="onNudge"><view class="chev chev--right"></view></view>
          </view>
        </view>

        <view class="footer-actions">
          <button class="btn btn--soft footer-btn" hover-class="btn--pressed" bindtap="cropImage">裁剪</button>
          <button class="btn btn--soft footer-btn" hover-class="btn--pressed" bindtap="chooseImage">重新选图</button>
          <button class="btn btn--primary footer-btn footer-btn--main" hover-class="btn--pressed" disabled="{{recognizing}}" bindtap="recognize">{{recognizing ? '识别中…' : '识别图纸'}}</button>
        </view>
      </view>
    </view>
  </block>
</view>
