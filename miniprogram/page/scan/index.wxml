<view class="page">
  <!-- 导入阶段 -->
  <block wx:if="{{stage === 'import'}}">
    <view class="hero">
      <view class="hero-title">识别已有图纸</view>
      <view class="hero-sub">截图/拍照导入，自动对齐网格后识别成色号网格</view>
    </view>
    <view class="card import-card" hover-class="import-card--pressed" bindtap="chooseImage">
      <view class="bead" aria-hidden="true"></view>
      <view class="import-title">点击导入图纸图片</view>
      <view class="import-sub">从相册选择，或拍一张</view>
    </view>
    <view class="card hint-card">
      <view class="section-title">怎么用</view>
      <view class="hint-line">1. 导入图纸截图或照片，尽量拍正、避免旋转</view>
      <view class="hint-line">2. 输入图纸长宽格数（宽=高）</view>
      <view class="hint-line">3. 缩放/拖动图片让色块对齐网格（可点自动对齐），确认后识别</view>
    </view>
  </block>

  <!-- 校准阶段：固定网格 + 移图 -->
  <block wx:else>
    <view class="calibrate">
      <view class="canvas-wrap">
        <canvas
          type="2d"
          id="scanCanvas"
          class="scan-canvas"
          bindtouchstart="onTouchStart"
          catchtouchmove="onTouchMove"
          bindtouchend="onTouchEnd"
          bindtouchcancel="onTouchCancel"
        ></canvas>
        <view class="canvas-tip">{{hint}}</view>
      </view>

      <view class="panel">
        <view class="size-row">
          <view class="size-field">
            <text class="size-label">宽（列）</text>
            <input class="size-input" type="number" value="{{cols}}" bindblur="onColsInput" bindconfirm="onColsInput" />
          </view>
          <text class="size-x">×</text>
          <view class="size-field">
            <text class="size-label">高（行）</text>
            <input class="size-input" type="number" value="{{rows}}" bindblur="onRowsInput" bindconfirm="onRowsInput" />
          </view>
          <view class="size-note">正方形</view>
        </view>

        <view class="chip-row">
          <view
            wx:for="{{colorSets}}"
            wx:key="*this"
            class="chip {{set === item ? 'chip--on' : ''}}"
            hover-class="chip--pressed"
            data-value="{{item}}"
            bindtap="pickSet"
          >{{item}} 色</view>
        </view>

        <view class="switch-row">
          <text class="switch-label">背景自动识别（无标号白格置空）</text>
          <switch checked="{{autoBg}}" color="#ff3a5d" bindchange="onAutoBgChange" />
        </view>

        <view class="nudge-row">
          <text class="nudge-label">对齐微调（1/10 格）</text>
          <view class="nudge-group">
            <view class="nudge-btn" data-dir="left" bindtap="onNudge">◀</view>
            <view class="nudge-btn" data-dir="up" bindtap="onNudge">▲</view>
            <view class="nudge-btn" data-dir="down" bindtap="onNudge">▼</view>
            <view class="nudge-btn" data-dir="right" bindtap="onNudge">▶</view>
          </view>
        </view>

        <view class="action-row">
          <button class="btn btn--soft action-btn" hover-class="btn--pressed" bindtap="onAutoAlign" disabled="{{autoAligning}}">{{autoAligning ? '对齐中…' : '自动对齐'}}</button>
          <button class="btn btn--soft action-btn" hover-class="btn--pressed" bindtap="resetAlign">重置对齐</button>
        </view>

        <view class="action-row">
          <button class="btn btn--soft action-btn" hover-class="btn--pressed" bindtap="chooseImage">重新选图</button>
          <button class="btn btn--primary action-btn" hover-class="btn--pressed" disabled="{{recognizing}}" bindtap="recognize">{{recognizing ? '识别中…' : '识别图纸'}}</button>
        </view>
      </view>
    </view>
  </block>
</view>
