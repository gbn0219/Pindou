/* Hallmark · genre: playful · macrostructure: Workbench · theme: Hum · enrichment: none
 * nav: N/A（微信小程序无站点导航） · footer: N/A（微信小程序无站点页脚）
 * 适配说明：WXSS 对 oklch() 支持不确定 → 已换算为 hex；小程序无法加载 Web 字体 → 系统圆体栈
 */
page {
  --color-paper: #e6c4fe;
  --color-paper-2: rgba(255, 255, 255, 0.72);
  --color-paper-3: rgba(255, 255, 255, 0.58);
  --color-ink: #12171b;
  --color-ink-2: rgba(18, 23, 27, 0.68);
  --color-neutral: rgba(18, 23, 27, 0.48);
  --color-rule: #12171b;
  --color-accent: #c4d3fe;
  --color-accent-deep: #12171b;
  --color-accent-3: #ff3a5d;
  --color-mint: #66da85;
  --color-lavender: #c28efb;
  --color-focus: #007cca;
  --color-accent-ink: #12171b;
  --color-card: #ffffff;
  --color-bead-hi: #ffffff;
  --color-cast-strong: rgba(18, 23, 27, 0.28);
  --color-shadow-inset: rgba(18, 23, 27, 0.1);
  --color-shadow: rgba(18, 23, 27, 0.12);
  --color-cast: rgba(18, 23, 27, 0.42);
  --font-display: "PingFang SC", "Microsoft YaHei", sans-serif;
  --font-body: "PingFang SC", "Microsoft YaHei", sans-serif;
  --font-label: "SF Mono", Consolas, monospace;
  --space-3xs: 4rpx;
  --space-2xs: 8rpx;
  --space-xs: 16rpx;
  --space-sm: 24rpx;
  --space-md: 32rpx;
  --space-lg: 48rpx;
  --space-xl: 80rpx;
  --space-2xl: 128rpx;
  /* 悬浮 tabBar 占位：上沿 158rpx + 空隙 32rpx，tab 页底部留白统一用它 */
  --space-tabbar: 190rpx;
  --text-xs: 20rpx;
  --text-sm: 26rpx;
  --text-base: 32rpx;
  --text-md: 40rpx;
  --text-lg: 50rpx;
  --text-xl: 62rpx;
  --radius-card: 20rpx;
  --radius-input: 16rpx;
  --radius-pill: 999rpx;
  --ease-out: cubic-bezier(0.16, 1, 0.3, 1);
  --ease-in: cubic-bezier(0.7, 0, 0.84, 0);
  --ease-in-out: cubic-bezier(0.65, 0, 0.35, 1);
  --ease-bounce: cubic-bezier(0.34, 1.56, 0.64, 1);
  --ease-drawer: cubic-bezier(0.32, 0.72, 0, 1);
  --dur-micro: 120ms;
  --dur-short: 220ms;
  --dur-long: 420ms;
  --dur-bounce: 280ms;
  --z-raised: 10;
  --z-sticky: 200;
  --z-modal: 400;
  background: var(--color-paper);
  background-image: linear-gradient(140deg, #e6c4fe 0%, #c4d3fe 34%, #a8e6ff 68%, #d2c4fe 100%);
  color: var(--color-ink);
  font-family: var(--font-body);
  font-size: var(--text-base);
  line-height: 1.6;
}

.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 96rpx;
  border-radius: var(--radius-pill);
  font-size: var(--text-md);
  font-weight: 600;
  font-family: var(--font-body);
  border: 0;
  line-height: 1;
  /* 松开回弹：过冲曲线让按钮 q弹落定 */
  transition: transform var(--dur-bounce) var(--ease-bounce);
}
.btn.btn--pressed {
  /* 按下立刻反馈（100ms），松开走上面的过冲回弹 */
  transform: scale(0.94);
  transition: transform 100ms var(--ease-out);
}
.btn::after {
  border: 0;
}
.btn--primary {
  background: var(--color-accent);
  color: var(--color-accent-ink);
  border: 5rpx solid #12171b;
  border-radius: 20rpx;
  box-shadow: 8rpx 8rpx 0 var(--color-cast);
  transition: transform var(--dur-micro) var(--ease-out), box-shadow var(--dur-micro) var(--ease-out);
}
.btn--primary.btn--pressed {
  transform: translateY(3rpx) scale(0.95);
  box-shadow: 2rpx 2rpx 0 var(--color-cast);
}
.btn--primary[disabled] {
  background: #ddd9ea;
  border-color: rgba(18, 23, 27, 0.32);
  color: rgba(18, 23, 27, 0.42);
  box-shadow: none;
}
.btn--soft {
  background: #ffffff;
  color: var(--color-ink);
  border: 5rpx solid #12171b;
  border-radius: 20rpx;
  box-shadow: 8rpx 8rpx 0 var(--color-cast);
  transition: transform var(--dur-micro) var(--ease-out), box-shadow var(--dur-micro) var(--ease-out);
}
.btn--soft.btn--pressed {
  transform: translateY(3rpx) scale(0.95);
  box-shadow: 2rpx 2rpx 0 var(--color-cast);
}
.btn--soft[disabled] {
  opacity: 0.5;
  box-shadow: none;
}
.btn--sm {
  height: 72rpx;
  padding: 0 var(--space-md);
  font-size: var(--text-sm);
  box-shadow: 4rpx 4rpx 0 var(--color-cast);
}
.btn--sm.btn--pressed {
  box-shadow: 1rpx 1rpx 0 var(--color-cast);
}
.btn--lg {
  width: 100%;
}
